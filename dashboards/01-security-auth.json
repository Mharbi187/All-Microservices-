{
  "id": null,
  "uid": "nexusaid-security-auth",
  "title": "🛡️ NexusAid — Sécurité & Authentification",
  "description": "Surveillance temps réel de l'authentification, des menaces et des activités suspectes",
  "tags": ["nexusaid", "security", "auth"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": { "refresh_intervals": ["10s", "30s", "1m", "5m", "15m"] },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "pluginId": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" },
        "hide": 2
      },
      {
        "name": "loki_ds",
        "type": "datasource",
        "pluginId": "loki",
        "current": { "text": "Loki", "value": "Loki" },
        "hide": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "✅ Connexions Réussies (24h)",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area", "textMode": "auto" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "green" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "$datasource" },
        "expr": "increase(http_server_requests_seconds_count{job=\"core-service\",uri=~\"/api/v1/auth/login.*\",status=\"200\"}[24h]) or vector(0)",
        "legendFormat": "Connexions"
      }]
    },
    {
      "id": 2,
      "title": "❌ Échecs de Connexion (24h)",
      "type": "stat",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 10 },
            { "color": "red", "value": 50 }
          ]}
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "$datasource" },
        "expr": "increase(http_server_requests_seconds_count{job=\"core-service\",uri=~\"/api/v1/auth/login.*\",status=\"401\"}[24h]) or vector(0)",
        "legendFormat": "Échecs"
      }]
    },
    {
      "id": 3,
      "title": "🔒 Comptes Verrouillés (24h)",
      "type": "stat",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "orange", "value": 1 },
            { "color": "red", "value": 5 }
          ]}
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "$datasource" },
        "expr": "increase(nexusaid_accounts_locked_total[24h]) or vector(0)",
        "legendFormat": "Verrouillés"
      }]
    },
    {
      "id": 4,
      "title": "🚨 IPs Suspectes (24h)",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 1 },
            { "color": "red", "value": 5 }
          ]}
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "$datasource" },
        "expr": "increase(nexusaid_suspicious_ip_total[24h]) or vector(0)",
        "legendFormat": "IPs Suspectes"
      }]
    },
    {
      "id": 5,
      "title": "📊 Score de Risque Max",
      "type": "gauge",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdLabels": true, "showThresholdMarkers": true },
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 100,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 30 },
            { "color": "orange", "value": 60 },
            { "color": "red", "value": 80 }
          ]}
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "$datasource" },
        "expr": "nexusaid_risk_score_max or vector(0)",
        "legendFormat": "Risk Score"
      }]
    },
    {
      "id": 6,
      "title": "🔑 Réinitialisations MDP (24h)",
      "type": "stat",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } } },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "$datasource" },
        "expr": "increase(http_server_requests_seconds_count{job=\"core-service\",uri=~\"/api/v1/auth/reset.*\"}[24h]) or vector(0)",
        "legendFormat": "Reset MDP"
      }]
    },
    {
      "id": 10,
      "title": "📈 Connexions par Heure",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 2, "fillOpacity": 10 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Connexions Réussies" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "Échecs Connexion" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "increase(http_server_requests_seconds_count{job=\"core-service\",uri=~\"/api/v1/auth/login.*\",status=\"200\"}[1h])",
          "legendFormat": "Connexions Réussies"
        },
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "increase(http_server_requests_seconds_count{job=\"core-service\",uri=~\"/api/v1/auth/login.*\",status=\"401\"}[1h])",
          "legendFormat": "Échecs Connexion"
        }
      ]
    },
    {
      "id": 11,
      "title": "🚨 Détection Bruteforce (5 min)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 2 }, "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "red", "value": 5 }
        ]}},
        "overrides": [{ "matcher": { "id": "byName", "options": "Seuil Bruteforce" }, "properties": [
          { "id": "custom.lineStyle", "value": { "dash": [10, 10], "fill": "dash" } },
          { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
        ]}]
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "increase(http_server_requests_seconds_count{job=\"core-service\",uri=~\"/api/v1/auth/login.*\",status=\"401\"}[1m])",
          "legendFormat": "Échecs / minute"
        },
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "vector(5)",
          "legendFormat": "Seuil Bruteforce"
        }
      ]
    },
    {
      "id": 20,
      "title": "📋 Logs Sécurité Temps Réel",
      "type": "logs",
      "gridPos": { "x": 0, "y": 12, "w": 24, "h": 10 },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [{
        "datasource": { "type": "loki", "uid": "$loki_ds" },
        "expr": "{container=~\"core-service|api-gateway\"} |= \"\" | line_format \"{{.level}} | {{.container}} | {{.message}}\"",
        "legendFormat": "",
        "maxLines": 100
      }]
    },
    {
      "id": 21,
      "title": "🔍 Logs Erreurs & Sécurité (ERROR/WARN/SECURITY)",
      "type": "logs",
      "gridPos": { "x": 0, "y": 22, "w": 24, "h": 8 },
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "showTime": true, "sortOrder": "Descending" },
      "targets": [{
        "datasource": { "type": "loki", "uid": "$loki_ds" },
        "expr": "{container=~\"core-service|api-gateway\"} |~ \"ERROR|WARN|SECURITY|BRUTE|BLOCK|SUSPICIOUS|ANOMALY\"",
        "legendFormat": "",
        "maxLines": 200
      }]
    }
  ]
}
