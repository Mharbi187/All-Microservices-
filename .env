# ============================================================
# NEXUS-AID — Environment Variables
# Copy this file to .env and fill in the values
# ============================================================

# API Configuration
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT=15000

# App Configuration  
VITE_APP_VERSION=1.0.0
VITE_DEFAULT_LANGUAGE=fr

# Feature Flags
VITE_ENABLE_AI=true
VITE_ENABLE_OFFLINE=true
