# Copy to `.env.local` (or export as environment variables) and fill real values.

# Google Earth Engine
GEE_SERVICE_ACCOUNT=your-service-account@project.iam.gserviceaccount.com
GEE_PRIVATE_KEY_PATH=./keys/gee-service-account.json

# OpenWeather API
OPENWEATHER_API_KEY=replace_me

# Twilio (SMS)
TWILIO_ACCOUNT_SID=replace_me
TWILIO_AUTH_TOKEN=replace_me
TWILIO_PHONE_NUMBER=+10000000000

# SendGrid (Email)
SENDGRID_API_KEY=replace_me
ALERT_EMAIL_FROM=alerts@example.org

# API
API_PORT=8000
FLASK_DEBUG=false
MODEL_TYPE=random_forest

# JWT RS256 public key (for token verification from gateway/core-service)
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nreplace_me\n-----END PUBLIC KEY-----
JWT_PUBLIC_KEY_FILE=

# RabbitMQ (for CV bridge and event publishing)
RABBITMQ_URL=amqp://user:password@localhost:5672/

# Core Service URL (for CV bridge to fetch CPR metrics)
CORE_SERVICE_URL=http://localhost:8080
