{
  "id": null,
  "uid": "nexusaid-api-gateway",
  "title": "🔀 NexusAid — API Gateway",
  "description": "Métriques temps réel de l'API Gateway : requêtes, latence, erreurs HTTP, top endpoints",
  "tags": ["nexusaid", "api-gateway", "http"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "⚡ Requêtes / Seconde",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 100 },
            { "color": "red", "value": 500 }
          ]}
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus" },
        "expr": "sum(rate(http_server_requests_seconds_count{job=\"api-gateway\"}[1m]))",
        "legendFormat": "RPS"
      }]
    },
    {
      "id": 2,
      "title": "⏱️ Latence P95 (ms)",
      "type": "stat",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 500 },
            { "color": "red", "value": 2000 }
          ]}
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus" },
        "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{job=\"api-gateway\"}[5m])) by (le)) * 1000",
        "legendFormat": "P95 ms"
      }]
    },
    {
      "id": 3,
      "title": "❌ Erreurs 5xx / min",
      "type": "stat",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 1 },
            { "color": "red", "value": 10 }
          ]}
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus" },
        "expr": "sum(increase(http_server_requests_seconds_count{job=\"api-gateway\",status=~\"5..\"}[1m]))",
        "legendFormat": "Erreurs 5xx"
      }]
    },
    {
      "id": 4,
      "title": "🚫 Erreurs 4xx / min",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 10 },
            { "color": "red", "value": 100 }
          ]}
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus" },
        "expr": "sum(increase(http_server_requests_seconds_count{job=\"api-gateway\",status=~\"4..\"}[1m]))",
        "legendFormat": "Erreurs 4xx"
      }]
    },
    {
      "id": 5,
      "title": "⚡ Taux de Succès",
      "type": "gauge",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdMarkers": true },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "yellow", "value": 90 },
            { "color": "green", "value": 99 }
          ]}
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus" },
        "expr": "(sum(rate(http_server_requests_seconds_count{job=\"api-gateway\",status=~\"2..\"}[5m])) / sum(rate(http_server_requests_seconds_count{job=\"api-gateway\"}[5m]))) * 100",
        "legendFormat": "Succès %"
      }]
    },
    {
      "id": 6,
      "title": "🔄 Circuit Breakers",
      "type": "stat",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "red", "value": 1 }
          ]},
          "mappings": [
            { "type": "value", "options": { "0": { "text": "FERMÉ ✅", "color": "green" }, "1": { "text": "OUVERT ❌", "color": "red" } } }
          ]
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus" },
        "expr": "max(resilience4j_circuitbreaker_state{state=\"open\"}) or vector(0)",
        "legendFormat": "Circuit Breaker"
      }]
    },
    {
      "id": 10,
      "title": "📊 Requêtes / sec par Code HTTP",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 16, "h": 8 },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "right", "calcs": ["max", "mean"] } },
      "fieldConfig": { "defaults": { "custom": { "lineWidth": 2, "fillOpacity": 5 } } },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"api-gateway\",status=~\"2..\"}[1m]))",
          "legendFormat": "2xx ✅"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"api-gateway\",status=\"400\"}[1m]))",
          "legendFormat": "400 Bad Request"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"api-gateway\",status=\"401\"}[1m]))",
          "legendFormat": "401 Unauthorized 🔒"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"api-gateway\",status=\"403\"}[1m]))",
          "legendFormat": "403 Forbidden 🚫"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"api-gateway\",status=\"404\"}[1m]))",
          "legendFormat": "404 Not Found"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"api-gateway\",status=~\"5..\"}[1m]))",
          "legendFormat": "5xx Erreur 🔴"
        }
      ]
    },
    {
      "id": 11,
      "title": "⏱️ Latence P50/P95/P99",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 4, "w": 8, "h": 8 },
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "lineWidth": 2 } } },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket{job=\"api-gateway\"}[5m])) by (le)) * 1000",
          "legendFormat": "P50 (médiane)"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{job=\"api-gateway\"}[5m])) by (le)) * 1000",
          "legendFormat": "P95"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{job=\"api-gateway\"}[5m])) by (le)) * 1000",
          "legendFormat": "P99"
        }
      ]
    },
    {
      "id": 20,
      "title": "🏆 Top 10 Endpoints (RPS)",
      "type": "table",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "options": { "sortBy": [{ "displayName": "RPS", "desc": true }] },
      "fieldConfig": {
        "defaults": { "custom": { "displayMode": "auto" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "RPS" }, "properties": [
            { "id": "custom.displayMode", "value": "color-background" },
            { "id": "thresholds", "value": { "mode": "absolute", "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]}}
          ]}
        ]
      },
      "targets": [{
        "datasource": { "type": "prometheus" },
        "expr": "topk(10, sum by (uri) (rate(http_server_requests_seconds_count{job=\"api-gateway\"}[5m])))",
        "legendFormat": "{{uri}}",
        "instant": true,
        "format": "table"
      }],
      "transformations": [
        { "id": "organize", "options": { "renameByName": { "uri": "Endpoint", "Value": "RPS" } } },
        { "id": "sortBy", "options": { "fields": [{ "displayName": "RPS", "desc": true }] } }
      ]
    },
    {
      "id": 21,
      "title": "🗺️ Heatmap Latence par Endpoint",
      "type": "heatmap",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "options": {
        "calculate": false,
        "color": { "scheme": "Oranges", "mode": "scheme" },
        "tooltip": { "show": true }
      },
      "targets": [{
        "datasource": { "type": "prometheus" },
        "expr": "sum(rate(http_server_requests_seconds_bucket{job=\"api-gateway\"}[5m])) by (le)",
        "legendFormat": "{{le}}",
        "format": "heatmap"
      }]
    }
  ]
}
