# ============================================================
# NEXUS AID — MONITORING ENVIRONMENT VARIABLES
# Copier et adapter ces valeurs avant de démarrer le stack
# ============================================================

# ─── GRAFANA ────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=NexusAid@2026!

# ─── SMTP (Gmail déjà configuré dans core-service) ──────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=c6287943@gmail.com
SMTP_PASSWORD=lqdgldnjygchljia
ALERT_EMAIL_TO=c6287943@gmail.com

# ─── POSTGRESQL EXPORTER ────────────────────────────────────
# Le container postgres est nommé nexus-aid-db sur le réseau nexus-aid-net
PG_EXPORTER_DSN=postgresql://postgres:postgres@nexus-aid-db:5432/nexusaid_db?sslmode=disable

# ─── OPENWA (WhatsApp API Gateway) ──────────────────────────
# Clé API pour sécuriser l'accès OpenWA
OPENWA_API_KEY=nexusaid-wa-2026

# Numéro WhatsApp de destination pour les alertes (format international sans +)
# Exemple: 212600000000 pour +212 600 000 000 (Maroc)
WA_ALERT_NUMBER=21651877406
